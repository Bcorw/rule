            {
                "clash_mode": "Direct",
                "action": "route",
                "server": "ali"
            },
            {
                "clash_mode": "Global",
                "action": "route",
                "server": "fakeip"
            },
            {
                "rule_set": [
                    "fakeipfilter-cn",
                    "geosite-cn",
                    "Samsung",
                    "geosite-microsoft@cn",
                    "geosite-private"
