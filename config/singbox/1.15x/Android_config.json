                "action": "route",
                "server": "ali"
            },
            {
                "rule_set": "geosite-category-ads-all",
                "action": "reject"
            },
            {
                "rule_set": "fakeipfilter-!cn",
                "action": "route",
                "server": "google"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "query_type": [
                            "A",
                            "AAAA"
                        ]
                    },
                    {
                        "rule_set": "geosite-geolocation-!cn",
                        "invert": true
                    }
                ],
                "action": "evaluate",
                "server": "ali",
                "timeout": "2s"
            },
            {
                "match_response": true,
                "rule_set": "geoip-cn",
                "action": "route",
                "server": "ali"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "action": "route",
                "server": "fakeip",
                "rewrite_ttl": 1
            }
        ],
        "final": "google",
        "strategy": "ipv4_only",
        "cache_capacity": 8192,
        "optimistic": {
            "enabled": true,
            "timeout": "1d"
        },
        "reverse_mapping": true
