  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "dns_mode": "hijack",
      "dns_address": [
        "172.19.0.2",
        "fdfe:dcba:9876::2"
      ],
      "mtu": 1400,
      "auto_route": true,
      "auto_redirect": true,
      "udp_timeout": "5m",
      "udp_nat_max": 4096,
      "udp_mapping": "endpoint_independent",
      "exclude_package": [
        "com.tencent.mm"
      ]
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "Android",
      "access_control_allow_private_network": false,
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/nakedcore/sing-box/dashboard",
        "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "Dashboard下载",
