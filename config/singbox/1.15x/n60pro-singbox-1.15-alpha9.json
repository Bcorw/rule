        "直连"
      ],
      "default": "直连"
    },
    {
      "tag": "漏网之鱼",
      "type": "selector",
      "outbounds": [
        "默认代理",
        "日本手动",
        "狮城手动",
        "香港手动",
        "美国手动",
        "流媒体手动",
        "低倍率手动",
        "自动选择",
        "直连"
      ],
      "default": "低倍率手动"
    },
    {
      "tag": "日本手动",
      "type": "selector",
      "outbounds": []
