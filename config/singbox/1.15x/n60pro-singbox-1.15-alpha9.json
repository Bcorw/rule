    {
      "tag": "流媒体手动",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "低倍率手动",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "手动选择",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "自动选择",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 100
    },
    {
      "tag": "延迟辅助",
      "type": "urltest",
      "outbounds": [
        "直连"
      ],
      "url": "http://connect.rom.miui.com/generate_204",
      "interval": "30m"
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "outbounds": [
        "默认代理",
        "日本手动",
        "狮城手动",
        "香港手动",
        "美国手动",
        "AI手动",
        "流媒体手动",
        "低倍率手动",
        "手动选择",
        "自动选择",
        "延迟辅助",
        "直连"
      ]
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "ali"
    }
  ],
  "http_clients": [
    {
      "tag": "代理下载",
      "detour": "默认代理",
      "tls": {
        "insecure": true
      }
    },
    {
      "tag": "直连下载",
      "detour": "直连",
      "tls": {
        "insecure": true
      }
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "port": [
              53,
              853
            ],
            "invert": true
          },
          {
            "clash_mode": "Global",
            "invert": true
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "ip_is_private": true
              },
              {
                "rule_set": "geoip-cn"
              }
            ]
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          },
          {
            "rule_set": "geoip-telegram"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns"
        ],
        "timeout": "100ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": [
              "stun",
              "quic"
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "action": "resolve"
      },
      {
        "network": "icmp",
        "outbound": "直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "AI"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "YouTube"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "Google"
      },
      {
        "rule_set": "geosite-github",
        "outbound": "Github"
      },
      {
        "rule_set": "geosite-onedrive",
        "outbound": "OneDrive"
      },
      {
        "rule_set": "Samsung",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-microsoft@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-microsoft",
        "outbound": "Microsoft"
      },
      {
        "rule_set": "geosite-apple@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-apple",
        "outbound": "Apple"
      },
      {
        "rule_set": "geosite-telegram",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geosite-tiktok",
        "outbound": "TikTok"
      },
      {
        "rule_set": "geosite-netflix",
        "outbound": "Netflix"
      },
      {
        "rule_set": "geosite-paypal",
        "outbound": "Wallet"
      },
      {
        "rule_set": "geosite-binance",
        "outbound": "Wallet"
      },
      {
        "rule_set": "geosite-okx",
        "outbound": "Wallet"
      },
      {
        "rule_set": "geosite-category-cryptocurrency",
        "outbound": "Wallet"
      },
      {
        "rule_set": "geosite-steam@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-steam",
        "outbound": "Steam"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "默认代理"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "fakeipfilter-cn",
          "fakeipfilter-!cn",
          "Samsung"
        ],
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"
      },
      {
        "tag": [
          "geosite-category-ai-!cn",
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-microsoft@cn",
          "geosite-apple",
          "geosite-apple@cn",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-netflix",
          "geosite-paypal",
          "geosite-binance",
          "geosite-okx",
          "geosite-category-cryptocurrency",
          "geosite-steam@cn",
          "geosite-steam",
          "geosite-geolocation-!cn",
          "geosite-cn",
          "geosite-private"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "漏网之鱼",
    "default_http_client": "代理下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    }
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "singtun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "dns_mode": "hijack",
      "dns_address": [
        "172.19.0.2",
        "fdfe:dcba:9876::2"
      ],
      "auto_route": true,
      "auto_redirect": true,
      "multi_queue": true,
      "exclude_mptcp": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "10.1.1.1",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9020,
      "secret": "SINGBOX",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true,
      "store_fakeip": true,
      "buffer_size": "1MB",
      "flush_interval": "1m"
    }
  },
  "certificate": {
    "store": "system"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
