      {
        "rule_set": "Samsung",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-microsoft@cn",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "geoip-cn",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-category-ads-all",
