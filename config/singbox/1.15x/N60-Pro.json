    "rule_set": [
      {
        "tag": "Samsung",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/Bcorw/rule/refs/heads/main/rules/Samsung.json",
        "update_interval": "72h",
