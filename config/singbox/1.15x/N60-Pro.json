{
  "dns": {
    "servers": [
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        },
        "detour": "直连"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "detour": "默认代理"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "weixin.qq.com",
          "wechat.com",
          "wx.qq.com",
          "weixinbridge.com",
          "wechatpay.cn",
          "tenpay.com",
          "qpic.cn",
          "qlogo.cn",
          "gtimg.cn"
        ],
        "action": "route",
        "server": "ali"
      },
      {
        "rule_set": [
          "geosite-category-ai-!cn",
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-telegram",
          "geosite-geolocation-!cn"
