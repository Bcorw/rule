subscription {
    L: 'https://' {
        cache: true
        route: direct
        ua: 'clash.meta/1.19.30'
    }

    K: 'https://' {
        cache: true
        route: direct
        ua: 'clash.meta/1.19.30'
    }

    N: 'https://' {
        cache: true
        route: direct
        ua: 'clash.meta/1.19.30'
    }
}

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {
    Proxy {
        filter: subtag('L', 'K') && !name(regex: '(?i)剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
        final: block
        interrupt_connections: true
    }
    AI {
        filter: subtag('N', 'K') && name(regex: '(?i)🇸🇬|\b(SG|SGP|SIN)\b|新加坡|狮城|獅城|Singapore|🇯🇵|JP|jp|日本|日|Japan|🇺🇸|US|美国|美|United States') && !name(regex: '(?i)流量|教育|双鱼座剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
        default: '🇸🇬Singapore 04'
        final: block
        interrupt_connections: true
    }
    YouTube {
        filter: subtag('L', 'K') && name(regex: '(?i)🇭🇰|\b(HK|HKG)\b|香港|港|Hong ?Kong') && !name(regex: '(?i)剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
        final: block
        interrupt_connections: true
    }
    Google {
        filter: subtag('L', 'K') && name(regex: '(?i)🇸🇬|\b(SG|SGP|SIN)\b|新加坡|狮城|獅城|Singapore') && !name(regex: '(?i)剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
        final: block
        interrupt_connections: true
    }
    Github {
        filter: subtag('L', 'K') && name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '剩余|距离|套餐|到期|官网|排除|expire|traffic')
        final: Final
        interrupt_connections: true
    }
    Telegram {
        filter: subtag('L', 'K') && name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '剩余|距离|套餐|到期|官网|排除|expire|traffic')
        final: Final
        interrupt_connections: true
    }
    Steam {
        filter: subtag('L', 'K') && name(regex: '(?i)🇭🇰|\b(HK|HKG)\b|香港|港|Hong ?Kong') && !name(regex: '(?i)剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
        final: block
        interrupt_connections: true
    }
    Microsoft {
        filter: subtag('L', 'K') && name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '剩余|距离|套餐|到期|官网|排除|expire|traffic')
        final: Final
        interrupt_connections: true
    }
    Final {
        filter: subtag('L', 'K') && !name(regex: '剩余|距离|套餐|到期|官网|排除|expire|traffic')
        policy: score
    }
}

dns {
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

routing {
    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)
    dport(853) -> block
    l4proto(udp) && dport(443) -> block
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> AI
    domain(geosite: youtube) -> YouTube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: telegram) -> Telegram
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam
    domain(geosite: geolocation-!cn) -> Proxy
    dip(geoip: telegram) -> Telegram
    fallback: Final
}

global {
    lan_interface: br-lan
    wan_interface: auto
    data_dir: '/etc/honk'
    dial_mode: domain
    tls_implementation: utls
    bootstrap_resolver: '223.5.5.5:53'
    auto_config_kernel_parameter: true
    nfqueue_enable: true
    store_subscribe: true
    log_level: info
    tcp_check_url: 'https://www.gstatic.com/generate_204', 'http://cp.cloudflare.com'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google:53', '8.8.8.8:53'
    check_interval: 60s
    check_tolerance: 50ms
    udp_warm_node_count: 0
    preconnect_node_count: 0
}
assets {
    route: direct
    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 24h
        cache: true
    }
    geodata {
        geosite: 'https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geosite.dat'
        geoip: 'https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geoip.dat'
        route: Proxy
    }
}
experimental {
    native_api {
        enabled: true
        listen: '10.0.0.1:9090'
        password_auth: true
        config_write: true
        ui: embedded
    }
    cache_file {
        enabled: true
        store_dns: true
    }
}
